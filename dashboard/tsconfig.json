{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "resolveJsonModule": true, "allowImportingTsExtensions": false
  },
  "include": ["src", "e2e", "e2e-static", "vite.config.ts", "vite.static.config.ts", "playwright.config.ts", "playwright.static.config.ts"]
}
