# `make env` generates deploy/.env with random values. This file shows what is in it.
POSTGRES_PASSWORD=change-me
AGENTSHIELD_APP_PASSWORD=change-me
AGENTSHIELD_WORKER_PASSWORD=change-me
AGENTSHIELD_MASTER_KEY=            # a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTSHIELD_KEY_PEPPER=change-me
AGENTSHIELD_JWT_SECRET=change-me
AGENTSHIELD_SESSION_SECRET=change-me
# Optional
# AGENTSHIELD_COOKIE_SECURE=true         # behind HTTPS
# AGENTSHIELD_CORS_ORIGINS=https://shield.example.com
# AGENTSHIELD_CLASSIFIER=onnx            # needs the ml extra and a model dir, see docs/classifier.md
# API_PORT=8000
# DASHBOARD_PORT=8080
